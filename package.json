{
  "name": "p2p-e2ee-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first peer-to-peer end-to-end encrypted chat built on MLS (RFC 9420)",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
